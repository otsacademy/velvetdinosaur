# Set the command-line arguments to pass to the server.
# Due to shell escaping, to pass backslashes for regexes, you need to double
# them (\\d for \d). If running under systemd, you need to double them again
# (\\\\d to mean \d), and escape newlines too.
ARGS="--config.file=/etc/prometheus/alertmanager.yml --web.listen-address=127.0.0.1:9093 --web.route-prefix=/alertmanager --web.external-url=https://velvetdinosaur.com/admin/alertmanager --cluster.listen-address=127.0.0.1:9094 --cluster.advertise-address=127.0.0.1:9094"
