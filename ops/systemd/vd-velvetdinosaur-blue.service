[Unit]
Description=Velvet Dinosaur velvetdinosaur blue slot
After=network.target

[Service]
Type=simple
User=ianw
Group=developers
WorkingDirectory=/srv/apps/.ops/sites/velvetdinosaur/slots/blue
EnvironmentFile=/srv/apps/.ops/sites/velvetdinosaur/slots/blue/.env.production
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
ExecStart=/usr/bin/env bash -lc 'exec bun run start -- --port ${PORT:-3061}'
Restart=always
RestartSec=5
KillMode=mixed

[Install]
WantedBy=multi-user.target
