{
  "version": 1,
  "targets": [
    {
      "name": "velvetdinosaur",
      "kind": "site",
      "gates": [
        {
          "name": "audit-dependencies",
          "command": "bun run audit:dependencies"
        },
        {
          "name": "test-dependencies",
          "command": "bun run test:dependencies"
        },
        {
          "name": "lint",
          "command": "bun run lint"
        },
        {
          "name": "typecheck",
          "command": "bun run typecheck"
        },
        {
          "name": "unit",
          "command": "bun run test:unit"
        },
        {
          "name": "security",
          "command": "bun run test:security"
        },
        {
          "name": "security-integration",
          "command": "bun run test:security:integration"
        },
        {
          "name": "newsletter-integration",
          "command": "bun run scripts/newsletter-mongo-test.ts"
        },
        {
          "name": "newsletter-release",
          "command": "bun test ops/scripts/newsletter-release-*.test.ts"
        },
        {
          "name": "build",
          "command": "bun run build"
        },
        {
          "name": "newsletter-unsubscribe",
          "command": "bun run test:newsletter:unsubscribe"
        },
        {
          "name": "portfolio-images",
          "command": "bun run portfolio:images:check"
        },
        {
          "name": "visual",
          "command": "bun run visual:test"
        },
        {
          "name": "lighthouse",
          "command": "bun run lighthouse"
        },
        {
          "name": "theme-smoke",
          "command": "bun run theme:smoke"
        }
      ]
    }
  ]
}
